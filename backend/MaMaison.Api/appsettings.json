{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MaMaison": "Server=(localdb)\\mssqllocaldb;Database=MaMaisonDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "FeatureFlags": {
    "Terrains": {
      "AllowInternalLandPublishing": true,
      "AllowOwnerLandPublishing": false,
      "AllowBrokerLandPublishing": false,
      "AllowAgencyLandPublishing": false,
      "AllowPublicLandPublishing": false
    },
    "Locations": {
      "AllowOwnerRentalPublishing": true,
      "RequireAdminValidationBeforePublishing": true
    },
    "Demarcheurs": {
      "AllowBrokerRegistration": true,
      "AllowBrokerDirectPublishing": false,
      "RequireBrokerMandate": true
    },
    "Visite3D": {
      "Enable3DVisit": true,
      "EnableAICustomization": false,
      "EnableMaterialCustomization": false
    }
  }
}
